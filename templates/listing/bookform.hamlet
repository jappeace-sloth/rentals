^{csrf}
<div class="mb-2">
  <label class="form-label" for=#{fvId startView}>Start date
  ^{fvInput startView}
<div class="mb-2">
  <label class="form-label" for=#{fvId endView}>End date
  ^{fvInput endView}
$if hasHouseRules
  <div class="mb-2 form-check">
    ^{fvInput rulesView}
    <label class="form-check-label" for=#{fvId rulesView}>I accept the house rules
<div class="d-grid mt-3">
  <button type=submit class="btn btn-primary">Book now
